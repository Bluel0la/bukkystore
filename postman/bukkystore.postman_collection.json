{
  "info": {
    "name": "Bukky Store API",
    "description": "Contract checks kept in sync with the Bukky Store OpenAPI document.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health/live",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health", "live"]
            },
            "description": "Confirms that the API process can serve requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns the strict liveness payload', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('status', 'service', 'version');",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.service).to.eql('bukkystore-api');",
                  "});",
                  "pm.test('returns correlation and timing headers', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[0-9a-f-]{36}$/);",
                  "  pm.expect(pm.response.headers.get('Server-Timing')).to.match(/^app;dur=/);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/categories", "host": ["{{base_url}}"], "path": ["api", "v1", "categories"] },
            "description": "Returns active store categories in display order."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns seeded categories', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.be.an('array').that.is.not.empty;",
            "  pm.expect(body.map(item => item.slug)).to.include('dresses');",
            "});"
          ] } }]
        },
        {
          "name": "Browse products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/products?limit=10", "host": ["{{base_url}}"], "path": ["api", "v1", "products"], "query": [{ "key": "limit", "value": "10" }] },
            "description": "Returns cursor-paginated active products with derived availability."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('does not expose exact stock', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.have.all.keys('items', 'next_cursor');",
            "  pm.expect(body.items.map(item => item.slug)).to.include('brown-linen-dress');",
            "  pm.expect(body.items[0]).not.to.have.property('stock_on_hand');",
            "});"
          ] } }]
        },
        {
          "name": "Get product detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/products/brown-linen-dress", "host": ["{{base_url}}"], "path": ["api", "v1", "products", "brown-linen-dress"] },
            "description": "Returns selectable colour-and-size variants for one active product."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns variant availability', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.slug).to.eql('brown-linen-dress');",
            "  pm.expect(body.variants).to.be.an('array').that.is.not.empty;",
            "  pm.expect(body.variants[0]).to.have.property('available');",
            "  const available = body.variants.find(variant => variant.available);",
            "  if (available) { pm.collectionVariables.set('checkout_variant_id', available.id); }",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "Commerce",
      "item": [
        {
          "name": "List delivery areas",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/delivery-areas", "host": ["{{base_url}}"], "path": ["api", "v1", "delivery-areas"] },
            "description": "Returns active Lagos delivery areas and server-owned fees."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns a configured delivery area', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.be.an('array').that.is.not.empty;",
            "  pm.collectionVariables.set('checkout_area_id', body[0].id);",
            "});"
          ] } }]
        },
        {
          "name": "Reject unavailable delivery area",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-safe-rejection-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"full_name\": \"Postman Checkout\",\n    \"phone\": \"08012345678\"\n  },\n  \"delivery\": {\n    \"area_id\": \"00000000-0000-0000-0000-000000000000\",\n    \"address\": \"12 Contract Test Street, Lagos\"\n  },\n  \"items\": [\n    {\n      \"variant_id\": \"{{checkout_variant_id}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/checkout", "host": ["{{base_url}}"], "path": ["api", "v1", "checkout"] },
            "description": "Exercises checkout validation without creating an order in the configured database."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 404', function () { pm.response.to.have.status(404); });",
            "pm.test('returns the safe delivery error', function () { pm.expect(pm.response.json().code).to.eql('delivery_area_not_found'); });"
          ] } }]
        },
        {
          "name": "Create checkout order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-checkout-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"full_name\": \"Postman Checkout\",\n    \"phone\": \"08012345678\",\n    \"email\": \"postman@bukkystore.invalid\"\n  },\n  \"delivery\": {\n    \"area_id\": \"{{checkout_area_id}}\",\n    \"address\": \"12 Contract Test Street, Lagos\",\n    \"directions\": \"Postman integration test\"\n  },\n  \"items\": [\n    {\n      \"variant_id\": \"{{checkout_variant_id}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"attribution\": {\n    \"source\": \"postman\",\n    \"campaign\": \"contract-gate\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/checkout", "host": ["{{base_url}}"], "path": ["api", "v1", "checkout"] },
            "description": "Creates an awaiting-payment guest order, reserves exact variant stock, and initializes the configured payment provider."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "if (String(pm.environment.get('run_checkout_write')).toLowerCase() !== 'true') { pm.execution.skipRequest(); }"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 201', function () { pm.response.to.have.status(201); });",
            "pm.test('returns server-calculated totals and payment handoff', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.order_status).to.eql('AWAITING_PAYMENT');",
            "  pm.expect(body.payment_status).to.eql('PENDING');",
            "  pm.expect(body.summary.total_minor).to.eql(body.summary.subtotal_minor + body.summary.delivery_fee_minor);",
            "  pm.expect(body.payment_url).to.be.a('string').that.is.not.empty;",
            "  pm.collectionVariables.set('postman_order_number', body.order_number);",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Cookie-authenticated catalogue operations. Login captures the CSRF cookie for mutating requests.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
        "if (!pm.environment.get('admin_email') || !pm.environment.get('admin_password')) { pm.execution.skipRequest(); }"
      ] } }],
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/admin/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "auth", "login"] },
            "description": "Creates an expiring server-side admin session. Credentials are injected as secret environment values."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns the authenticated user', function () { pm.expect(pm.response.json().user).to.have.all.keys('id', 'email', 'display_name', 'role'); });",
            "const cookies = pm.response.headers.all().filter(header => header.key.toLowerCase() === 'set-cookie').map(header => header.value).join(';');",
            "const csrf = cookies.match(/bukky_admin_csrf=([^;]+)/);",
            "if (csrf) { pm.collectionVariables.set('csrf_token', decodeURIComponent(csrf[1])); }"
          ] } }]
        },
        {
          "name": "Current admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/admin/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "auth", "me"] },
            "description": "Resolves the current active admin session."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "List admin categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/admin/categories", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "categories"] },
            "description": "Returns active and inactive categories for management. POST and PATCH use the same resource with the CSRF header."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns categories', function () { pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; });"
          ] } }]
        },
        {
          "name": "List admin products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/admin/products?limit=10", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "products"], "query": [{ "key": "limit", "value": "10" }] },
            "description": "Returns exact stock and reservation counts for catalogue management. POST creates a product; GET/PATCH by UUID edit it; the archive action performs archival."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns exact inventory', function () { const body = pm.response.json(); pm.expect(body.items).to.be.an('array').that.is.not.empty; pm.expect(body.items[0].variants[0]).to.have.property('stock_on_hand'); });"
          ] } }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrf_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/admin/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "auth", "logout"] },
            "description": "Revokes the current session and clears both cookies."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 204', function () { pm.response.to.have.status(204); });"] } }]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "secret"
    }
  ]
}
